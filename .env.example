# ----- Intelligence (pick ONE primary; the other is optional fallback) -----

# AI_PROVIDER selects the active LLM. Defaults to whichever key is set;
# explicit value wins. Allowed: minimax | anthropic | fallback
AI_PROVIDER=minimax

# MiniMax API key. Treated as primary by default.
# Get one at https://www.minimaxi.com/platform/account/api-key
MINIMAX_API_KEY=

# Optional: override MiniMax endpoint (defaults are auto-probed)
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-Text-01

# Optional Anthropic fallback. Without either key, the app runs with
# deterministic template responses (full UI still works).
ANTHROPIC_API_KEY=

# ----- Storage -----

# Absolute path to the SQLite database file. On Railway, point this to a
# mounted volume (e.g. /data/forgecloud.sqlite) so data survives redeploys.
# Defaults to <cwd>/.data/forgecloud.sqlite
INSFORGE_DB_PATH=

# ----- Server -----

# Both set automatically by Railway; only override for local dev if needed.
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=development
