# ----- Intelligence (pick ONE primary; the other is optional fallback) -----

# AI_PROVIDER selects the active LLM. Defaults to whichever key is set;
# explicit value wins. Allowed: minimax | anthropic | fallback
AI_PROVIDER=minimax

# MiniMax API key. Treated as primary by default.
# Get one at https://www.minimaxi.com/platform/account/api-key
MINIMAX_API_KEY=

# Optional: override MiniMax endpoint (defaults are auto-probed)
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-Text-01

# Optional Anthropic fallback. Without either key, the app runs with
# deterministic template responses (full UI still works).
ANTHROPIC_API_KEY=

# ----- Storage -----

# Absolute path to the SQLite database file. On Railway, point this to a
# mounted volume (e.g. /data/forgecloud.sqlite) so data survives redeploys.
# Defaults to <cwd>/.data/forgecloud.sqlite
INSFORGE_DB_PATH=

# Directory for generated runtime artifacts and manifests. When unset, this
# defaults next to INSFORGE_DB_PATH if that is set; otherwise it uses
# <cwd>/.data/runtime-artifacts. On Railway, prefer /data/runtime-artifacts.
FORGECLOUD_RUNTIME_ARTIFACT_DIR=

# ----- Server -----

# Both set automatically by Railway; only override for local dev if needed.
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=development

# Required when NODE_ENV=production or AUTH_REQUIRED=true. Sessions are signed
# with HMAC-SHA256 and can be provided by the `fc_session` cookie or
# `x-forgecloud-session` header. Generate a long random value before launch.
AUTH_SESSION_SECRET=

# Optional local/staging switch to force signed sessions outside NODE_ENV=production.
AUTH_REQUIRED=false

# Local-only escape hatch for unsigned seeded-owner access. Leave false for any
# deployed environment.
ALLOW_DEV_AUTH_FALLBACK=false

# Passwordless login code delivery. Production login requests require this
# webhook unless AUTH_LOGIN_RETURN_CODE=true is explicitly set for staging/tests.
AUTH_LOGIN_WEBHOOK_URL=
AUTH_LOGIN_RETURN_CODE=false

# ----- Deployment provider -----

# Local development defaults to simulation. Production defaults to production
# mode, which blocks production deploys until a real provider hook and public URL
# are configured.
# Allowed: simulation | production
FORGECLOUD_DEPLOY_MODE=simulation

# Allowed: railway | cloudflare
FORGECLOUD_DEPLOY_PROVIDER=railway

# Railway deploy hook generated in the Railway service settings.
# Required when FORGECLOUD_DEPLOY_MODE=production and provider=railway.
RAILWAY_DEPLOY_HOOK_URL=

# The stable public Railway service URL shown to users after a deploy.
# PUBLIC_APP_URL can be used instead if you front Railway with a custom domain.
RAILWAY_SERVICE_URL=
PUBLIC_APP_URL=

# Cloudflare Pages deploy hook and stable project URL.
# Required when FORGECLOUD_DEPLOY_MODE=production and provider=cloudflare.
CLOUDFLARE_DEPLOY_HOOK_URL=
CLOUDFLARE_PROJECT_URL=

# Optional shared secret sent as an Authorization bearer token to deploy hooks.
DEPLOY_HOOK_TOKEN=

# Keep false in production unless you intentionally need demo failure buttons.
FORGECLOUD_ENABLE_FAILURE_INJECTION=false

# Enables destructive demo seed/reset endpoints in production. Leave false for
# real teams.
ENABLE_DEMO_ENDPOINTS=false

# Comma-separated frontend origins allowed to call the API with credentials in a
# split frontend/backend deployment. PUBLIC_APP_URL, CLOUDFLARE_PROJECT_URL, and
# RAILWAY_SERVICE_URL are allowed automatically when set.
FORGECLOUD_ALLOWED_ORIGINS=

# Frontend-only: set this on Cloudflare Pages when the API runs on Railway.
# Leave blank for monolithic Railway deployments.
VITE_API_BASE=

# ----- Hackathon stack adapters -----

# Set this to true in production when ForgeCloud must fail readiness unless
# Butterbase, XTrace, Composio, and RocketRide are all configured live.
FORGECLOUD_REQUIRE_LIVE_STACK=false

# RocketRide powers the multi-agent workflow. When unset, ForgeCloud uses the
# local agent orchestrator and records RocketRide activity in simulation mode.
ROCKETRIDE_WORKFLOW_URL=
ROCKETRIDE_API_KEY=
ROCKETRIDE_CALLBACK_SECRET=

# Butterbase is the backend/source of truth. When unset, ForgeCloud uses the
# local SQLite store as a Butterbase-compatible demo backend.
BUTTERBASE_PROJECT_URL=
BUTTERBASE_API_KEY=

# XTrace stores long-term project memory for Plain-English Blame. When unset,
# ForgeCloud persists memory locally in memory_entries/activity_events.
XTRACE_MEMORY_URL=
XTRACE_API_KEY=

# Composio powers external app connections. When unset, ForgeCloud simulates
# connector discovery through in-app connections, notifications, and Activity.
COMPOSIO_WEBHOOK_URL=
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1
COMPOSIO_USER_PREFIX=forgecloud
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_GOOGLE_SHEETS_AUTH_CONFIG_ID=
COMPOSIO_GOOGLE_CALENDAR_AUTH_CONFIG_ID=
COMPOSIO_SLACK_AUTH_CONFIG_ID=
COMPOSIO_STRIPE_AUTH_CONFIG_ID=
COMPOSIO_NOTION_AUTH_CONFIG_ID=
COMPOSIO_HUBSPOT_AUTH_CONFIG_ID=
COMPOSIO_SHOPIFY_AUTH_CONFIG_ID=
